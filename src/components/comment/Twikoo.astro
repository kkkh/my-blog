<!--
  Twikoo 评论容器 + 视觉覆盖
  ───────────────────────────────────────────────
  初始化已移出到 Layout.astro 的「评论驱动控制器」按需执行（与 Waline 共享切换器）；
  此处只留容器与样式。

  ⚠️ 关键：必须多包一层 data-engine="twikoo" 的外壳。
  Twikoo 内部用 Vue 2 的 `new Vue({...}).$mount('#twikoo')`，
  而 Vue 2 的 $mount(el) 会【替换掉】目标节点 —— 替换后：
    1. #twikoo 这个 id 与 class 一并消失，直接给 #twikoo 加 display:none 无效；
    2. 所有 #twikoo 作用域的样式全部失效。
  所以：显隐与 data-ready 标记都放在外层永不被替换的壳上，
        CSS 也一律以 [data-engine='twikoo'] 作用域，而非 #twikoo。
-->
<div class="comment-driver is-active" data-engine="twikoo">
  <div id="twikoo"></div>
</div>

<style is:global>
  [data-engine='twikoo'] {
    font-family: inherit;
  }
  [data-engine='twikoo'] * {
    font-family: inherit;
  }
  [data-engine='twikoo'] .el-textarea textarea {
    border: 1px solid color-mix(in srgb, var(--color-border-primary) 30%, transparent) !important;
    border-radius: 1rem !important;
    background: color-mix(
      in srgb,
      var(--color-text-primary) 3%,
      var(--color-bg-primary)
    ) !important;
    color: var(--color-text-primary) !important;
    font-size: 0.9rem !important;
    line-height: 1.6 !important;
    padding: 1rem !important;
    transition: all 0.3s ease;
  }
  [data-engine='twikoo'] .el-textarea textarea:focus {
    outline: none !important;
    border-color: var(--color-accent) !important;
  }
  [data-engine='twikoo'] .tk-action-btn,
  [data-engine='twikoo'] .tk-btn {
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent) !important;
    border-radius: 2rem !important;
    background: color-mix(in srgb, var(--color-accent) 8%, transparent) !important;
    color: var(--color-accent) !important;
    font-weight: 600 !important;
    font-size: 0.8rem !important;
    padding: 0.4rem 1.2rem !important;
    transition: all 0.3s ease !important;
    cursor: pointer;
  }
  [data-engine='twikoo'] .tk-action-btn:hover,
  [data-engine='twikoo'] .tk-btn:hover {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent) !important;
  }
  [data-engine='twikoo'] .tk-comment {
    border: 1px solid color-mix(in srgb, var(--color-border-primary) 20%, transparent) !important;
    border-radius: 1rem !important;
    background: color-mix(
      in srgb,
      var(--color-text-primary) 2%,
      var(--color-bg-primary)
    ) !important;
    padding: 1.25rem !important;
    margin-bottom: 0.75rem !important;
  }
  [data-engine='twikoo'] .tk-comment:hover {
    border-color: color-mix(in srgb, var(--color-accent) 20%, transparent) !important;
  }
  [data-engine='twikoo'] .tk-avatar {
    border-radius: 0.75rem !important;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border-primary) 15%, transparent) !important;
  }
  [data-engine='twikoo'] .tk-avatar img {
    border-radius: 0.75rem !important;
  }
  [data-engine='twikoo'] .tk-author {
    color: var(--color-accent) !important;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
  }
  [data-engine='twikoo'] .tk-time {
    color: color-mix(in srgb, var(--color-text-primary) 40%, transparent) !important;
    font-size: 0.75rem !important;
  }
  [data-engine='twikoo'] .tk-content {
    color: var(--color-text-primary) !important;
    line-height: 1.7 !important;
    font-size: 0.9rem !important;
  }
  [data-engine='twikoo'] .tk-replies {
    margin-left: 0.5rem !important;
    padding-left: 1rem !important;
    border-left: 2px solid color-mix(in srgb, var(--color-accent) 15%, transparent) !important;
  }
</style>

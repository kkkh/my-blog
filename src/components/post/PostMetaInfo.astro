---
import { RelativeDate } from './RelativeDate'
import ReadCount from './ReadCount.astro'

interface Props {
  date: Date
  lastMod?: Date
  words: number
  readingMinutes: number
  postPath?: string
  postTitle?: string
  class?: string
}

const { date, lastMod, words, readingMinutes, postPath, postTitle, class: className } = Astro.props
---

<div class="flex flex-wrap gap-2 text-sm text-secondary" class:list={[className]}>
  <div>
    <i class="iconfont icon-calendar"></i>
    <RelativeDate date={date} client:idle />
  </div>
  {lastMod && (
    <div>
      <svg class="inline-block -mt-[1px]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <RelativeDate date={lastMod} client:idle />
    </div>
  )}
  <div>
    <i class="iconfont icon-file-list"></i>
    <span>{words} 字</span>
  </div>
  <div>
    <i class="iconfont icon-timer"></i>
    <span>{Math.ceil(readingMinutes)} 分钟</span>
  </div>
  {postPath && postTitle && <ReadCount postPath={postPath} postTitle={postTitle} class="flex items-center gap-1" />}
</div>

---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import { BackToTopFAB } from '@/components/BackToTopFAB'
import { ToastContainer } from '@/components/ToastContainer'
import { ModalStack } from '@/components/ui/modal'
import Analytics from '@vercel/analytics/astro'
import { site } from '@/config.json'
import AuroraBackground from '@/components/background/AuroraBackground.astro'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <CommonHead title={title} description={description} image={image} />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
    <script
      is:inline
      async
      defer
      src="https://um.mingcy.cn/script.js"
      data-website-id="2dec6bd6-3aa9-49f5-a7ec-cb0c23c74f44"></script>
    <script
      is:inline
      async
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="86be4560-edbf-468b-9897-813f94dfe6c3"></script>
    <!-- 朋友圈插件样式：放在 head 全局加载（Swup 切页不替换 head），避免 main 内 link 在切页后未加载导致卡片样式丢失 -->
    <link rel="stylesheet" href="/fclite/fclite.css" />
    <!-- Fancybox 图片灯箱样式（本地化，避免 CDN 被跟踪防护拦截） -->
    <link rel="stylesheet" href="/fancybox/fancybox.min.css" />
  </head>
  <body>
    <AuroraBackground />
    <div class="site-grain hidden-mobile pointer-events-none fixed inset-0 z-0" aria-hidden="true">
    </div>

    <slot />

    <BackToTopFAB client:only="react" />
    <ToastContainer client:only="react" />
    <ModalStack client:only="react" />
    <Analytics />
    <script is:inline>
      // Swup 切页前（main 内容替换前）通知 main 内所有 React island 释放
      // 定时器/rAF/观察器/监听器，防止旧实例泄漏导致页面切换卡顿
      document.addEventListener('swup:content:replace', () => {
        document.dispatchEvent(new CustomEvent('mcy:island-cleanup'))
      })
    </script>
    <script is:inline>
      // 滚动时临时移除 backdrop-filter（毛玻璃是滚动重绘卡顿的主因），
      // 滚动停止 120ms 后恢复玻璃效果；配合 body.is-scrolling 的 CSS 降级规则
      ;(function () {
        var ticking = false
        var timer = null
        var onScroll = function () {
          if (ticking) return
          ticking = true
          requestAnimationFrame(function () {
            document.body.classList.add('is-scrolling')
            ticking = false
            clearTimeout(timer)
            timer = setTimeout(function () {
              document.body.classList.remove('is-scrolling')
            }, 120)
          })
        }
        window.addEventListener('scroll', onScroll, { passive: true })
      })()
    </script>
    <script is:inline>
      // 代码块复制按钮（委托到 document，Swup 切页后依然生效）
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.copy-code')
        if (!btn) return
        var block = btn.closest('.code-block')
        var pre = block ? block.querySelector('pre') : null
        var text = pre ? pre.innerText : ''
        if (!text) return
        navigator.clipboard
          .writeText(text)
          .then(function () {
            btn.textContent = '已复制 ✓'
            setTimeout(function () {
              btn.textContent = '复制'
            }, 800)
          })
          .catch(function () {
            btn.textContent = '复制失败'
            setTimeout(function () {
              btn.textContent = '复制'
            }, 1200)
          })
      })
    </script>
    <script is:inline>
      // 朋友圈页（/links/fcircle）初始化：Swup 切页后 main 容器内的 inline 脚本不会重新执行，
      // 会导致插件区空白、友链状态卡"加载中"。故在此 body 级常驻脚本统一处理，
      // 页面首次加载与 Swup 切页后自动触发（插件加载 + 友链状态）。
      ;(function () {
        var FCLITE_JS = '/fclite/fclite.js'

        // 插件配置（fclite.js 初始化依赖，Swup 切页后 main 内的 UserConfig 不会重跑）
        window.UserConfig = window.UserConfig || {
          private_api_url: 'https://fc.mingcy.cn/',
          page_turning_number: 24,
          error_img: '/fclite/avatar-fallback.svg',
        }

        function ensureFclite(cb) {
          if (typeof initialize_fc_lite === 'function') {
            cb()
            return
          }
          if (document.querySelector('script[data-fclite]')) return
          var s = document.createElement('script')
          s.src = FCLITE_JS
          s.setAttribute('data-fclite', '1')
          s.onload = cb
          // 加载失败：清除标记，稍后随下一次 boot 重试
          s.onerror = function () {
            s.removeAttribute('data-fclite')
            setTimeout(boot, 1000)
          }
          document.head.appendChild(s)
        }

        function esc(t) {
          if (!t) return ''
          var d = document.createElement('div')
          d.textContent = t
          return d.innerHTML
        }

        // 确保 fclite.css 已加载（防 main 内 link 在 Swup 切页后未应用）
        function ensureFcliteCss() {
          var found = false
          for (var i = 0; i < document.styleSheets.length; i++) {
            var href = document.styleSheets[i].href || ''
            if (href.indexOf('/fclite/fclite.css') !== -1) {
              found = true
              break
            }
          }
          if (!found && !document.querySelector('link[data-fclite-css]')) {
            var l = document.createElement('link')
            l.rel = 'stylesheet'
            l.href = '/fclite/fclite.css'
            l.setAttribute('data-fclite-css', '1')
            document.head.appendChild(l)
          }
        }

        function boot() {
          ensureFcliteCss()

          // 1) 插件动态流
          var root = document.getElementById('friend-circle-lite-root')
          if (root) {
            ensureFclite(function () {
              if (root.children.length === 0) initialize_fc_lite()
            })
          }

          // 2) 友链状态（data-state 防重复拉取）
          var summary = document.getElementById('links-summary')
          var grid = document.getElementById('links-grid')
          if (summary && summary.dataset.state !== 'done') {
            summary.dataset.state = 'done'
            fetch('https://fc.mingcy.cn/status.json')
              .then(function (r) {
                return r.json()
              })
              .then(function (data) {
                var links = data.link_status || []
                var ok = 0
                links.forEach(function (it) {
                  if (it.success) ok++
                })
                summary.innerHTML =
                  '<span class="stat-ok">' +
                  ok +
                  ' 正常</span>' +
                  '<span class="stat-sep">·</span>' +
                  '<span class="stat-fail">' +
                  (links.length - ok) +
                  ' 异常</span>'
                if (!grid) return
                grid.innerHTML = links
                  .map(function (item) {
                    var cls = item.success ? 'ok' : 'fail'
                    var label = item.success ? '正常' : '异常'
                    return (
                      '<a class="status-card ' +
                      cls +
                      '" href="' +
                      item.link +
                      '" target="_blank" rel="noopener" title="' +
                      esc(item.name) +
                      '">' +
                      '<span class="sc-indicator"></span>' +
                      '<span class="sc-name">' +
                      esc(item.name) +
                      '</span>' +
                      '<span class="sc-label">' +
                      label +
                      '</span></a>'
                    )
                  })
                  .join('')
              })
              .catch(function () {
                summary.textContent = '暂无数据'
              })
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot)
        } else {
          setTimeout(boot, 200)
          setTimeout(boot, 800)
        }
        // Swup 4 替换后事件：page:view（@swup/astro 在替换完成后派发，同时触发 astro:page-load）
        document.addEventListener('swup:page:view', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
        document.addEventListener('astro:page-load', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
      })()
    </script>
    <!-- 评论系统驱动控制器：Twikoo / Waline 双引擎切换 -->
    <script is:inline>
      // ────────────────────────────────────────────────
      // 为什么控制器放在 Layout（而不是评论组件里）：
      //   Swup 切页只替换 <main>、不重建 body，本脚本常驻单例；
      //   main 内的 inline 脚本由 SwupScriptsPlugin 每次重跑，
      //   若在组件内初始化，每切一篇文章就新建一个评论实例且旧的永不销毁。
      // 两个引擎都按需懒加载：Twikoo 772KB（官方 CDN）/ Waline 262KB（本地），
      //   只有用户真的切到对应系统才下载，首页与无评论页零成本。
      // ────────────────────────────────────────────────
      ;(function () {
        var KEY = 'mcy-comment-driver'
        var TWIKOO_ENV_ID = 'https://twikoo.mingcy.cn/'
        // 官方 CDN：jsDelivr 主源 + unpkg 备源（版本钉死 1.7.19，
        // 与云函数 twikoo-vercel 1.7.19 对齐；本地 public/twikoo/ 已删除）
        var TWIKOO_JS = [
          'https://cdn.jsdelivr.net/npm/twikoo@1.7.19/dist/twikoo.all.min.js',
          'https://unpkg.com/twikoo@1.7.19/dist/twikoo.all.min.js',
        ]
        var WALINE_SERVER = 'https://waline.mingcy.cn'
        var WALINE_JS = '/waline/waline.js'
        var WALINE_CSS = '/waline/waline.css'

        var twikooScript = null
        var twikooTryIndex = 0
        var walinePromise = null
        var walineInstance = null
        var walinePath = null
        var shownDriver = null

        function block() {
          return document.getElementById('comment-block')
        }

        function readDriver() {
          try {
            return localStorage.getItem(KEY) === 'waline' ? 'waline' : 'twikoo'
          } catch (e) {
            return 'twikoo'
          }
        }

        function writeDriver(driver) {
          try {
            localStorage.setItem(KEY, driver)
          } catch (e) {}
        }

        // 懒加载指示器：只跟随当前展示的系统，避免用户已切走后误关别人的加载态
        function setLoader(driver, on, error) {
          if (driver !== shownDriver) return
          var b = block()
          var el = b ? b.querySelector('.driver-loading') : null
          if (!el) return
          if (on) {
            el.hidden = false
            var text = el.querySelector('.driver-loading__text')
            if (text) {
              text.textContent = error
                ? error
                : driver === 'waline'
                  ? '正在加载 Waline 评论…'
                  : '正在加载 Twikoo 评论…'
            }
            el.setAttribute('data-error', error ? '1' : '0')
          } else {
            el.hidden = true
            el.removeAttribute('data-error')
          }
        }

        function syncUI(driver) {
          var b = block()
          if (!b) return
          shownDriver = driver
          b.querySelectorAll('.comment-driver').forEach(function (el) {
            // 用 data-engine 而非 id：Twikoo 的 Vue 2 $mount 会替换掉 #twikoo 节点，
            // 替换后 id 就没了，而外层 data-engine 壳始终存在
            el.classList.toggle('is-active', el.getAttribute('data-engine') === driver)
          })
          b.querySelectorAll('.driver-switch__btn').forEach(function (btn) {
            var on = btn.getAttribute('data-driver') === driver
            btn.classList.toggle('is-active', on)
            btn.setAttribute('aria-selected', on ? 'true' : 'false')
            btn.tabIndex = on ? 0 : -1
          })
          var track = b.querySelector('.driver-switch__track')
          if (track) {
            if (!window.__mcyCommentDriverSynced) {
              // 首次同步：避免高亮块从默认位滑动到记忆位的多余动画
              track.style.transition = 'none'
            }
            track.style.transform = driver === 'waline' ? 'translateX(100%)' : 'translateX(0)'
            if (!window.__mcyCommentDriverSynced) {
              requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                  track.style.transition = ''
                })
              })
            }
          }
          window.__mcyCommentDriverSynced = true
        }

        // ─── Twikoo（官方 CDN 懒加载，只有切到本引擎才下载） ───
        // Twikoo 用 Vue 2 的 $mount('#twikoo')，会把 #twikoo 节点整个替换掉；
        // 因此幂等标记 data-ready 必须打在永不被替换的外层壳上。
        function twikooSlot() {
          return document.querySelector('#comment-block .comment-driver[data-engine="twikoo"]')
        }

        // ─── 把 Twikoo 运行时注入的 <style> 挪出 <head> ───
        // Twikoo 的 CSS 不是文件：twikoo.all.min.js 内是 webpack vue-style-loader
        // 内联样式，脚本首次加载时一次性往 document.head 注入 16 个 <style>
        // （v1.7.19 实测共 37KB），之后无论再调用多少次 twikoo.init() 都不会重新
        // 注入（webpack 模块已缓存）。
        // 而 @swup/astro 默认开启 updateHead（@swup/head-plugin），它挂在
        // before("content:replace")：每次切页都会把 <head> 里「下一页静态 HTML 的
        // head 中不存在」的元素全部 removeChild。Twikoo 的 16 个 <style> 正是
        // 运行时注入、静态 HTML 里不存在 → 切页一次就被删掉且永不补回，
        // 于是第二篇文章起评论样式全部丢失（首篇正常，之后永久失效）。
        // 识别只能靠内容：vue-style-loader 注入的 <style> 连 data-vue-ssr-id
        // 属性都没有（bundle 内 ssrId 为假值）。且这 16 个片段并不都属于 twikoo 自己的
        // 命名空间 —— 实测分布：
        //   .tk-*   twikoo 本体（评论列表 / 提交 / 分页 / 管理面板…）
        //   .el-*   Element UI（按钮 / 文本域 / 标签…，约占 49% 体积）
        //   OwO     表情面板
        // 只匹配 tk-comment 只能覆盖 15% 的样式，三个特征必须都认。
        // <style> 挪到 <body> 后依然全文档生效，且不属 head 清理范围；
        // 本站 head 内的内联样式只有随机强调色变量（不含 tk-/el-/OwO），不会误伤。
        // 函数幂等，重复调用只是空转。
        function adoptTwikooStyles() {
          var styles = document.head.querySelectorAll('style')
          for (var i = 0; i < styles.length; i++) {
            var st = styles[i]
            var css = st.textContent || ''
            if (css.indexOf('tk-') === -1 && css.indexOf('el-') === -1 && css.indexOf('OwO') === -1) {
              continue
            }
            document.body.appendChild(st)
          }
        }

        function initTwikoo() {
          var slot = twikooSlot()
          if (!slot || slot.getAttribute('data-ready')) return
          if (typeof twikoo !== 'undefined' && twikoo.init) {
            mountTwikoo()
            return
          }
          if (twikooScript) return // 上一次请求还在飞行（含 CDN 自动切换期间）
          setLoader('twikoo', true)
          loadTwikooScript()
        }

        // 多源加载：某个 CDN 被浏览器跟踪防护 / 网络拦截时自动换下一个源，
        // 两个源都失败才给用户报错（保持原有 onerror 提示行为不变）
        function loadTwikooScript() {
          if (twikooTryIndex >= TWIKOO_JS.length) {
            setLoader('twikoo', true, 'Twikoo 加载失败，请刷新重试')
            return
          }
          twikooScript = document.createElement('script')
          twikooScript.src = TWIKOO_JS[twikooTryIndex++]
          twikooScript.onload = function () {
            // CSS 就是脚本加载这一刻注入 head 的，必须马上挪走；
            // 一旦等到 Swup 切页之后才挪，@swup/head-plugin 已经删掉了
            adoptTwikooStyles()
            mountTwikoo()
          }
          twikooScript.onerror = function () {
            twikooScript = null
            loadTwikooScript()
          }
          document.head.appendChild(twikooScript)
        }

        function mountTwikoo() {
          var slot = twikooSlot()
          if (!slot || slot.getAttribute('data-ready')) return
          if (typeof twikoo === 'undefined' || !twikoo.init) {
            setLoader('twikoo', true, 'Twikoo 加载失败，请刷新重试')
            return
          }
          slot.setAttribute('data-ready', '1')
          setLoader('twikoo', false)
          // 兜底（幂等）：覆盖 onload 之外的所有挂载路径
          adoptTwikooStyles()
          twikoo.init({ envId: TWIKOO_ENV_ID, el: '#twikoo' })
        }

        // ─── Waline（本地化 /waline/） ───
        function ensureWalineCss() {
          if (document.querySelector('link[data-waline-css]')) return
          var link = document.createElement('link')
          link.rel = 'stylesheet'
          link.href = WALINE_CSS
          link.setAttribute('data-waline-css', '1')
          // 挂到 <body> 而非 <head>：<link> 放 body 是合法 HTML5，
          // 而 @swup/head-plugin 只清理 <head> 子节点 —— 放 head 里每个 Swup 切页
          // 都会把它删掉（ensureWalineCss 下次虽会重挂自愈），
          // 中间仍会出现 150~300ms 的 Waline 无样式窗口
          document.body.appendChild(link)
        }

        function destroyWaline() {
          if (!walineInstance) return
          try {
            walineInstance.destroy()
          } catch (e) {}
          walineInstance = null
          walinePath = null
        }

        function initWaline() {
          var el = document.getElementById('waline')
          if (!el) return
          var path = window.location.pathname

          if (walineInstance) {
            // 实例仍挂在当前文档里：同页切回 → 复用；跨页 → update 换 path
            if (walineInstance.el && document.contains(walineInstance.el)) {
              if (walinePath !== path) {
                walinePath = path
                try {
                  walineInstance.update({ path: path })
                } catch (e) {}
              }
              setLoader('waline', false)
              return
            }
            // 旧实例挂在已被 Swup 移除的节点上：销毁后重建到新容器
            destroyWaline()
          }

          setLoader('waline', true)
          ensureWalineCss()
          if (walinePromise) {
            walinePromise.then(mountWaline).catch(walineError)
            return
          }
          walinePromise = import(WALINE_JS)
            .then(function (mod) {
              mountWaline(mod)
            })
            .catch(function () {
              walinePromise = null
              walineError()
            })
        }

        function mountWaline(mod) {
          var el = document.getElementById('waline')
          if (!el) return
          var init = (mod && (mod.init || (mod.default && mod.default.init))) || null
          if (!init) {
            walineError()
            return
          }
          var path = window.location.pathname
          try {
            walineInstance = init({
              el: '#waline',
              path: path,
              serverURL: WALINE_SERVER,
              lang: 'zh-CN',
              // 跟随本站 data-theme 切换明暗（Waline 原生支持选择器形式）
              dark: '[data-theme="dark"]',
              // 注意：requiredMeta 只认 nick / mail / link，写 'email' 会被静默丢弃
              requiredMeta: ['nick', 'mail'],
              pageSize: 20,
              commentSorting: 'latest',
              // 官方 Weibo 表情集，走 jsDelivr（站点已依赖 jsDelivr，避开 unpkg 301 与被拦截风险）
              emoji: ['https://cdn.jsdelivr.net/npm/@waline/emojis@1.1.0/weibo'],
              highlighter: true,
              noCopyright: true,
            })
            walinePath = path
          } catch (e) {
            walineInstance = null
            walineError()
            return
          }
          setLoader('waline', false)
        }

        function walineError() {
          walinePromise = null
          setLoader('waline', true, 'Waline 加载失败，请刷新重试')
        }

        // ─── 切换入口 ───
        function switchTo(driver) {
          var b = block()
          if (!b) return
          if (driver !== 'twikoo' && driver !== 'waline') return
          writeDriver(driver)
          syncUI(driver)
          if (driver === 'waline') initWaline()
          else initTwikoo()
        }

        function boot() {
          var b = block()
          if (!b) {
            // 无评论区的页面：释放上一页遗留的 Waline 实例
            destroyWaline()
            return
          }
          var driver = readDriver()
          syncUI(driver)
          if (driver === 'waline') initWaline()
          else initTwikoo()
        }

        // 事件委托：只绑一次，Swup 切页后的新 DOM 自动生效
        if (!window.__mcyCommentDriverBound) {
          window.__mcyCommentDriverBound = true

          document.addEventListener('click', function (e) {
            var btn = e.target.closest('.driver-switch__btn')
            if (!btn || !btn.closest('#comment-block')) return
            switchTo(btn.getAttribute('data-driver'))
          })

          document.addEventListener('keydown', function (e) {
            var btn = e.target.closest('.driver-switch__btn')
            if (!btn || !btn.closest('#comment-block')) return
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
            e.preventDefault()
            var group = btn.closest('.driver-switch')
            if (!group) return
            var list = Array.prototype.slice.call(group.querySelectorAll('.driver-switch__btn'))
            var idx = list.indexOf(btn)
            var next =
              e.key === 'ArrowRight'
                ? (idx + 1) % list.length
                : (idx - 1 + list.length) % list.length
            switchTo(list[next].getAttribute('data-driver'))
            list[next].focus()
          })
        }

        // 首次加载
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot)
        } else {
          boot()
          setTimeout(boot, 200)
        }
        // Swup 切页：新文章 = 新 path，需重建/更新评论实例
        document.addEventListener('swup:page:view', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
        document.addEventListener('astro:page-load', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
      })()
    </script>
    <!-- Fancybox 图片灯箱（本地化，避免 CDN 被跟踪防护拦截）
         data-swup-ignore-script 不能省：@swup/astro 默认开启 SwupScriptsPlugin
         （head:true + body:true），它在 content:replace 时用 querySelectorAll 扫【整个
         document】的 script:not([data-swup-ignore-script])，把每个 <script> 克隆重建并
         重新执行。不带这个属性时，Swup 每切一次页 Fancybox 都会被重定义成全新实例
         （openers 清空、点击监听器丢失），而下面 initFancybox 的 +200ms 重绑可能先于
         UMD 重加载完成 → 灯箱彻底失效，点击变成直跳图片直链 -->
    <script is:inline src="/fancybox/fancybox.umd.min.js" data-swup-ignore-script></script>
    <!-- 初始化脚本同样标记 ignore：它的监听器都挂在 document 上（Swup 永不替换），
         首次加载时就已生效；不带标记会被 SwupScriptsPlugin 每切一次页克隆重跑一次，
         astro:page-load 监听器无限累加（initFancybox 虽幂等，但调用次数随切页数增长） -->
    <script is:inline data-swup-ignore-script>
      // Fancybox 初始化：全站统一图片预览组件
      function initFancybox() {
        if (typeof Fancybox === 'undefined') return
        // 当前页没有可弹的图就不绑定（相册页/文章页才会命中）
        if (!document.querySelector('[data-fancybox]')) return
        // 先销毁旧实例，防止 Swup 切页后重复绑定
        Fancybox.unbind(document.body)
        // 绑定所有带 data-fancybox 属性的元素
        Fancybox.bind('[data-fancybox]', {
          // 触摸支持：左右滑动切换图片，垂直滑动关闭
          touch: { vertical: true },
          // 轮播无限循环
          Carousel: { infinite: true },
          // 预加载相邻1张图片
          preload: 1,
          // 读取 img 的 alt 作为图片标题
          Caption: { type: 'auto' },
          // 显示工具栏：关闭按钮 + 图片计数
          Toolbar: { display: { infobar: true, close: true } },
          // 按键盘方向键切换图片
          Keyboard: { horizontal: true, vertical: true },
          // 灰色遮罩背景
          backdrop: true,
        })
      }
      // 首次加载
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFancybox)
      } else {
        initFancybox()
      }
      // Swup/Astro 无刷新切页后重新绑定
      document.addEventListener('swup:page:view', function () {
        setTimeout(initFancybox, 200)
      })
      document.addEventListener('astro:page-load', function () {
        setTimeout(initFancybox, 200)
      })
    </script>
    <!-- LivePhoto 实况照片支持 -->
    <script is:inline src="/livephoto/heolivephoto.js" defer></script>
  </body>
</html>

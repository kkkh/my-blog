---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import { BackToTopFAB } from '@/components/BackToTopFAB'
import { ToastContainer } from '@/components/ToastContainer'
import { ModalStack } from '@/components/ui/modal'
import SpeedInsights from '@vercel/speed-insights/astro'
import Analytics from '@vercel/analytics/astro'
import { site } from '@/config.json'
import AuroraBackground from '@/components/background/AuroraBackground.astro'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <CommonHead title={title} description={description} image={image} />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
    <script is:inline async defer src="https://um.mingcy.cn/script.js" data-website-id="2dec6bd6-3aa9-49f5-a7ec-cb0c23c74f44"></script>
    <script is:inline async defer src="https://cloud.umami.is/script.js" data-website-id="86be4560-edbf-468b-9897-813f94dfe6c3"></script>
    <!-- 朋友圈插件样式：放在 head 全局加载（Swup 切页不替换 head），避免 main 内 link 在切页后未加载导致卡片样式丢失 -->
    <link rel="stylesheet" href="/fclite/fclite.css" />
    <!-- Fancybox 图片灯箱样式 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancyapps-ui/6.0.29/fancybox/fancybox.min.css" />
  </head>
  <body>
    <AuroraBackground />
    <div class="site-grain hidden-mobile pointer-events-none fixed inset-0 z-0" aria-hidden="true"></div>

    <slot />

    <BackToTopFAB client:only="react" />
    <ToastContainer client:only="react" />
    <ModalStack client:only="react" />
    <SpeedInsights />
    <Analytics />
    <script is:inline>
      // Swup 切页前（main 内容替换前）通知 main 内所有 React island 释放
      // 定时器/rAF/观察器/监听器，防止旧实例泄漏导致页面切换卡顿
      document.addEventListener('swup:content:replace', () => {
        document.dispatchEvent(new CustomEvent('mcy:island-cleanup'))
      })
    </script>
    <script is:inline>
      // 滚动时临时移除 backdrop-filter（毛玻璃是滚动重绘卡顿的主因），
      // 滚动停止 120ms 后恢复玻璃效果；配合 body.is-scrolling 的 CSS 降级规则
      (function () {
        var ticking = false
        var timer = null
        var onScroll = function () {
          if (ticking) return
          ticking = true
          requestAnimationFrame(function () {
            document.body.classList.add('is-scrolling')
            ticking = false
            clearTimeout(timer)
            timer = setTimeout(function () {
              document.body.classList.remove('is-scrolling')
            }, 120)
          })
        }
        window.addEventListener('scroll', onScroll, { passive: true })
      })()
    </script>
    <script is:inline>
      // 代码块复制按钮（委托到 document，Swup 切页后依然生效）
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.copy-code')
        if (!btn) return
        var block = btn.closest('.code-block')
        var pre = block ? block.querySelector('pre') : null
        var text = pre ? pre.innerText : ''
        if (!text) return
        navigator.clipboard
          .writeText(text)
          .then(function () {
            btn.textContent = '已复制 ✓'
            setTimeout(function () {
              btn.textContent = '复制'
            }, 800)
          })
          .catch(function () {
            btn.textContent = '复制失败'
            setTimeout(function () {
              btn.textContent = '复制'
            }, 1200)
          })
      })
    </script>
    <script is:inline>
      // 朋友圈页（/links/fcircle）初始化：Swup 切页后 main 容器内的 inline 脚本不会重新执行，
      // 会导致插件区空白、友链状态卡"加载中"。故在此 body 级常驻脚本统一处理，
      // 页面首次加载与 Swup 切页后自动触发（插件加载 + 友链状态）。
      ;(function () {
        var FCLITE_JS = '/fclite/fclite.js'

        // 插件配置（fclite.js 初始化依赖，Swup 切页后 main 内的 UserConfig 不会重跑）
        window.UserConfig = window.UserConfig || {
          private_api_url: 'https://fc.mingcy.cn/',
          page_turning_number: 24,
          error_img: '/fclite/avatar-fallback.svg',
        }

        function ensureFclite(cb) {
          if (typeof initialize_fc_lite === 'function') {
            cb()
            return
          }
          if (document.querySelector('script[data-fclite]')) return
          var s = document.createElement('script')
          s.src = FCLITE_JS
          s.setAttribute('data-fclite', '1')
          s.onload = cb
          // 加载失败：清除标记，稍后随下一次 boot 重试
          s.onerror = function () {
            s.removeAttribute('data-fclite')
            setTimeout(boot, 1000)
          }
          document.head.appendChild(s)
        }

        function esc(t) {
          if (!t) return ''
          var d = document.createElement('div')
          d.textContent = t
          return d.innerHTML
        }

        // 确保 fclite.css 已加载（防 main 内 link 在 Swup 切页后未应用）
        function ensureFcliteCss() {
          var found = false
          for (var i = 0; i < document.styleSheets.length; i++) {
            var href = document.styleSheets[i].href || ''
            if (href.indexOf('/fclite/fclite.css') !== -1) {
              found = true
              break
            }
          }
          if (!found && !document.querySelector('link[data-fclite-css]')) {
            var l = document.createElement('link')
            l.rel = 'stylesheet'
            l.href = '/fclite/fclite.css'
            l.setAttribute('data-fclite-css', '1')
            document.head.appendChild(l)
          }
        }

        function boot() {
          ensureFcliteCss()

          // 1) 插件动态流
          var root = document.getElementById('friend-circle-lite-root')
          if (root) {
            ensureFclite(function () {
              if (root.children.length === 0) initialize_fc_lite()
            })
          }

          // 2) 友链状态（data-state 防重复拉取）
          var summary = document.getElementById('links-summary')
          var grid = document.getElementById('links-grid')
          if (summary && summary.dataset.state !== 'done') {
            summary.dataset.state = 'done'
            fetch('https://fc.mingcy.cn/status.json')
              .then(function (r) {
                return r.json()
              })
              .then(function (data) {
                var links = data.link_status || []
                var ok = 0
                links.forEach(function (it) {
                  if (it.success) ok++
                })
                summary.innerHTML =
                  '<span class="stat-ok">' +
                  ok +
                  ' 正常</span>' +
                  '<span class="stat-sep">·</span>' +
                  '<span class="stat-fail">' +
                  (links.length - ok) +
                  ' 异常</span>'
                if (!grid) return
                grid.innerHTML = links
                  .map(function (item) {
                    var cls = item.success ? 'ok' : 'fail'
                    var label = item.success ? '正常' : '异常'
                    return (
                      '<a class="status-card ' +
                      cls +
                      '" href="' +
                      item.link +
                      '" target="_blank" rel="noopener" title="' +
                      esc(item.name) +
                      '">' +
                      '<span class="sc-indicator"></span>' +
                      '<span class="sc-name">' +
                      esc(item.name) +
                      '</span>' +
                      '<span class="sc-label">' +
                      label +
                      '</span></a>'
                    )
                  })
                  .join('')
              })
              .catch(function () {
                summary.textContent = '暂无数据'
              })
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot)
        } else {
          setTimeout(boot, 200)
          setTimeout(boot, 800)
        }
        // Swup 4 替换后事件：page:view（@swup/astro 在替换完成后派发，同时触发 astro:page-load）
        document.addEventListener('swup:page:view', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
        document.addEventListener('astro:page-load', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
      })()
    </script>
    <!-- Fancybox 图片灯箱 -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/fancyapps-ui/6.0.29/fancybox/fancybox.umd.min.js"></script>
    <script is:inline>
      // Fancybox 初始化：绑定文章图片点击事件，Swup 切页后重新绑定
      function initFancybox() {
        if (typeof Fancybox === 'undefined') return
        Fancybox.bind('[data-fancybox="gallery"]', {
          Toolbar: {
            display: {
              left: [],
              middle: [],
              right: ['close'],
            },
          },
          Thumbs: false,
        })
      }
      // 首次加载
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFancybox)
      } else {
        initFancybox()
      }
      // Swup 切页后重新绑定
      document.addEventListener('swup:page:view', function () {
        setTimeout(initFancybox, 200)
      })
      document.addEventListener('astro:page-load', function () {
        setTimeout(initFancybox, 200)
      })
    </script>
    <!-- LivePhoto 实况照片支持 -->
    <script is:inline src="/livephoto/heolivephoto.js" defer></script>
  </body>
</html>

<!-- Apple Liquid Glass: detail page archetype (patterns.md §A) -->
<!-- Solid white panels with hairline dividers; glass only on nav/overlay; grayscale body + one accent -->
---
import PageLayout from '@/layouts/PageLayout.astro'
import config from '@/config.json'

const { author, hero } = config
---

<PageLayout title="关于 - 茗辰原" description="茗辰原的个人介绍页面">
  <div class="mx-auto max-w-4xl px-4 py-20">

    <!-- Header card -->
    <div class="mb-8 flex flex-col items-center gap-6 rounded-2xl border border-accent/10 bg-secondary/30 p-8 text-center backdrop-blur-sm md:flex-row md:text-left">
      <img
        src={author.avatar}
        alt={hero.name}
        class="h-32 w-32 flex-shrink-0 rounded-full border-4 border-accent/30 shadow-lg shadow-accent/20"
      />
      <div>
        <h1 class="bg-gradient-to-r from-accent to-purple-400 bg-clip-text text-4xl font-bold text-transparent">{hero.name}</h1>
        <p class="mt-2 text-lg text-secondary">{hero.bio}</p>
        <p class="mt-1 text-sm text-secondary/60">{hero.description}</p>
        <div class="mt-3 flex flex-wrap justify-center gap-2 md:justify-start">
          <span class="rounded-lg border border-accent/20 bg-accent/10 px-3 py-1 text-sm text-accent">INFJ-T</span>
          <span class="rounded-lg border border-primary/10 bg-secondary/20 px-3 py-1 text-sm text-secondary">学生</span>
          <span class="rounded-lg border border-primary/10 bg-secondary/20 px-3 py-1 text-sm text-secondary">网络安全</span>
        </div>
      </div>
    </div>

    <!-- Motto -->
    <div class="mb-8 rounded-2xl border border-accent/10 bg-secondary/30 p-6 text-center backdrop-blur-sm">
      <p class="text-xl italic text-accent">「 源于热爱而去创造 」</p>
    </div>

    <!-- Skills -->
    <div class="mb-8 rounded-2xl border border-accent/10 bg-secondary/30 p-6 backdrop-blur-sm">
      <h2 class="mb-6 text-xl font-bold text-primary">技能</h2>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-3">
        {
          [
            { name: 'HTML', level: 90, color: '#e9572b' },
            { name: 'JavaScript', level: 80, color: '#f7cb4f' },
            { name: 'Git', level: 75, color: '#df5b40' },
            { name: 'TypeScript', level: 70, color: '#3178c6' },
            { name: 'Python', level: 65, color: '#3776ab' },
            { name: 'CSS', level: 85, color: '#1572b6' },
          ].map((skill) => (
            <div class="flex flex-col items-center gap-2">
              <div class="relative flex h-20 w-20 items-center justify-center">
                <svg class="h-20 w-20 -rotate-90" viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="34" fill="none" stroke="rgb(var(--color-accent) / 0.1)" stroke-width="6" />
                  <circle cx="40" cy="40" r="34" fill="none" stroke={skill.color} stroke-width="6"
                    stroke-dasharray={2 * Math.PI * 34}
                    stroke-dashoffset={2 * Math.PI * 34 * (1 - skill.level / 100)}
                    stroke-linecap="round" />
                </svg>
                <span class="absolute text-sm font-bold text-primary">{skill.level}%</span>
              </div>
              <span class="text-sm text-secondary">{skill.name}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Timeline -->
    <div class="mb-8 rounded-2xl border border-accent/10 bg-secondary/30 p-6 backdrop-blur-sm">
      <h2 class="mb-6 text-xl font-bold text-primary">生涯</h2>
      <div class="space-y-6">
        {
          [
            { date: '2007-03-29', title: '出生', desc: '新疆乌鲁木齐' },
            { date: '2012', title: '第一次接触电脑', desc: '第一次摸电脑,两个指头敲文字' },
            { date: '2020', title: '开始编程之旅', desc: '因为性格问题,我开始从编程中寻求快乐' },
            { date: '2022', title: '编程转折时间', desc: '入门第一门语言是易语言,之后又想做网页,学习了HTML' },
            { date: '2023', title: '博客建站日期', desc: '第一次用的免费的虚拟主机,使用WP作为博客框架' },
            { date: '2024-1.21', title: '博客迁移日期', desc: '购买了mingcy.cn的域名,使用hexo作为站点' },
            { date: '2025', title: '持续学习与分享', desc: '网络安全方向学习，撰写技术文章' },
            { date: '2026', title: '博客升级', desc: '迁移到 Astro，全新的体验' },
          ].map((item) => (
            <div class="relative border-l-2 border-accent/30 pl-5">
              <div class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full bg-accent shadow shadow-accent/50" />
              <span class="font-mono text-xs text-accent">{item.date}</span>
              <h3 class="mt-1 text-primary">{item.title}</h3>
              <p class="text-sm text-secondary">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Games & Interests -->
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-accent/10 bg-secondary/30 p-6 backdrop-blur-sm">
        <h2 class="mb-4 text-xl font-bold text-primary">游戏</h2>
        <ul class="space-y-2 text-sm text-secondary">
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent" />香肠派对 — 单四 KD:9.9</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-purple-400" />极品飞车 — 单排 车王段位</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-yellow-400" />光遇 — 跑图大师</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-accent/10 bg-secondary/30 p-6 backdrop-blur-sm">
        <h2 class="mb-4 text-xl font-bold text-primary">标签</h2>
        <div class="flex flex-wrap gap-2">
          {['数码科技', '编程技术', '开源', '生活', '音乐', '分享', '日常'].map((t) => (
            <span class="rounded-full border border-primary/10 bg-accent/5 px-3 py-1 text-sm text-secondary">{t}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 text-center text-sm text-secondary/50">
      <img src="https://webp.mingcy.cn" alt="random" class="mx-auto mt-4 h-24 w-48 rounded-lg object-cover opacity-70" />
    </div>
  </div>
</PageLayout>
